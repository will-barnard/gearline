DB_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
JWT_SECRET=change-me-use-at-least-64-random-characters-here-for-production

# Bootstrap admin account — set these before first deploy.
# On every startup the app will upsert this account as ADMIN with this password.
# If not set, the fallback seed account (admin@gearline.io / GearlineAdmin1!) is used.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Shopify Flows "Send HTTP Request" static token (different from the webhook HMAC secret)
SHOPIFY_FLOW_SECRET=
# Header name Flows will send the token in (default: X-Shopify-Flow-Token)
SHOPIFY_FLOW_TOKEN_HEADER=X-Shopify-Flow-Token
REVERB_CLIENT_ID=
REVERB_CLIENT_SECRET=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName from the eBay Developer Portal — the short string assigned when you
# register your redirect URL (e.g. YourApp-YourApp-12345-abcde).
# Find it under: My Account → User Tokens → <your keyset> → View / Edit → RuName
EBAY_RU_NAME=
# Verification token for eBay account-deletion notifications (GDPR/CCPA compliance).
# Choose any string (e.g. `openssl rand -hex 32`) and paste the SAME value into
# the Developer Portal under Application Keys → Notifications → Verification token.
# Your endpoint URL to register there: https://yourdomain.com/api/v1/marketplace/ebay/notifications
EBAY_NOTIFICATION_VERIFICATION_TOKEN=
# AES-256-GCM key for encrypting marketplace OAuth tokens at rest.
# Generate with: openssl rand -base64 32
# Leave blank for local development (stores tokens as plain JSON — NOT for production).
CREDENTIAL_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost
