# ─────────────────────────────────────────────────────────────────────────────
# Gearline environment
#
# On Beachhead these are set in the dashboard as GLOBAL variables (no Target
# Service). ${VAR} substitution in docker-compose.yml only reads from .env, and
# Beachhead only writes global vars there — a targeted variable resolves to an
# empty string in compose without warning.
# ─────────────────────────────────────────────────────────────────────────────

DB_PASSWORD=change-me

# ── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: the signing algorithm is derived from this string's BYTE LENGTH,
# matching the behaviour of the Java service it replaced:
#
#     32-47 bytes -> HS256
#     48-63 bytes -> HS384
#     64+   bytes -> HS512
#
# Changing the length changes the algorithm and invalidates every existing
# token, logging out every user. Below 32 bytes the service refuses to start.
JWT_SECRET=change-me-use-at-least-64-random-characters-here-for-production

# ── Bootstrap admin ──────────────────────────────────────────────────────────
# Upserted as an active ADMIN on every startup, so redeploying is how you
# rotate the admin password. If unset, the V8 migration's seed account
# (admin@gearline.io / GearlineAdmin1!) is the fallback.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
# Also the webhook HMAC key. If this is blank, webhook signature validation is
# SKIPPED and every unsigned webhook is accepted — never leave it unset in
# production.
SHOPIFY_CLIENT_SECRET=
# Shopify Flows "Send HTTP Request" static token. Distinct from the HMAC secret
# above: Flows does not sign payloads, so this is a plain shared secret.
SHOPIFY_FLOW_SECRET=
SHOPIFY_FLOW_TOKEN_HEADER=X-Shopify-Flow-Token

# ── Reverb ───────────────────────────────────────────────────────────────────
REVERB_CLIENT_ID=
REVERB_CLIENT_SECRET=

# ── eBay ─────────────────────────────────────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName — a short registered identifier, NOT a URL. eBay's redirect_uri
# parameter takes this value; passing an actual URL fails with an opaque
# invalid_request. Find it under:
#   My Account -> User Tokens -> <your keyset> -> View / Edit -> RuName
EBAY_RU_NAME=

# Verification token for eBay account-deletion notifications (GDPR/CCPA).
# Until this endpoint verifies, eBay keeps your developer keyset DISABLED.
#
# Constraints: 32-80 chars, alphanumeric plus _ and - only.
# Do NOT use `openssl rand -base64` — it emits + / = which eBay rejects.
# Generate with:
#   LC_ALL=C tr -dc 'a-zA-Z0-9_-' </dev/urandom | head -c 64
#
# Paste the SAME value into the Developer Portal under
# Application Keys -> Notifications -> Verification token, and register:
#   https://yourdomain.com/api/v1/marketplace/ebay/notifications
#
# If verification fails, GET /api/v1/marketplace/ebay/notifications/debug shows
# the exact endpoint URL being hashed — a mismatch there is nearly always why.
EBAY_NOTIFICATION_VERIFICATION_TOKEN=

# ── Credential encryption ────────────────────────────────────────────────────
# AES-256-GCM key for marketplace OAuth tokens at rest. Base64, 32 bytes.
#   openssl rand -base64 32
#
# Blank = pass-through mode, tokens stored as plain JSON. Development only.
# Changing this key makes every stored token unreadable and silently drops
# every marketplace connection.
CREDENTIAL_ENCRYPTION_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public HTTPS base URL, no trailing slash. Used to build OAuth redirect URIs,
# webhook registration addresses, and the eBay notification endpoint hash.
APP_BASE_URL=http://localhost

# ─────────────────────────────────────────────────────────────────────────────
# No longer used (the Java service was retired):
#   RABBITMQ_PASSWORD      — the queue is pg-boss, inside Postgres
#   SPRING_RABBITMQ_*      — ditto
#   SPRING_REDIS_*         — Redis is gone
#   SPRING_DATASOURCE_*    — still accepted as a fallback, but DATABASE_URL is
#                            set directly in docker-compose.yml
# Delete these from the Beachhead dashboard.
# ─────────────────────────────────────────────────────────────────────────────
